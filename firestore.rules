rules_version = '2';

// Khroga security rules (free Spark plan: there is no server, so these rules
// are what keep everything safe and fair). Places are bundled in the app and
// never stored here.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isMe(uid) { return signedIn() && me() == uid; }
    function isGuest() { return request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function newData() { return request.resource.data; }
    function changed() { return newData().diff(resource.data).affectedKeys(); }
    function validName(n) { return n is string && n.size() > 0 && n.size() <= 40; }
    function pairId(a, b) { return a < b ? a + '_' + b : b + '_' + a; }

    // ---- Private user data ----
    match /users/{uid} {
      allow read: if isMe(uid);
      allow create, update: if isMe(uid) && newData().keys().hasOnly(['createdAt']);
      // "Delete my account" removes everything, including this document.
      allow delete: if isMe(uid);

      // Plans: only the owner can see or change them.
      match /plans/{planId} {
        allow read, delete: if isMe(uid);
        allow create: if isMe(uid)
          && newData().keys().hasOnly(['title', 'summary', 'stops', 'request', 'tips',
                                       'weatherNote', 'source', 'saved', 'createdAt'])
          && newData().source in ['ai', 'fallback', 'local']
          && newData().stops is list && newData().stops.size() <= 5
          && newData().title is string && newData().title.size() <= 80
          && newData().saved == false
          && newData().createdAt == request.time;
        // Owner can (un)save, or swap stops (still at most 5).
        // Owner can (un)save, rename, or edit stops (still at most 5).
        // "Make it nicer with AI" may also replace the summary, tips and source.
        allow update: if isMe(uid)
          && changed().hasOnly(['saved', 'stops', 'title', 'summary', 'tips', 'source'])
          && newData().saved is bool
          && newData().summary is string && newData().summary.size() <= 400
          && newData().tips is list && newData().tips.size() <= 3
          && newData().source in ['ai', 'fallback', 'local']
          && newData().stops is list && newData().stops.size() <= 5
          && newData().title is string && newData().title.size() > 0
          && newData().title.size() <= 80;
      }

      // Places you've been to: just a place id and when.
      match /visited/{placeId} {
        allow read, delete: if isMe(uid);
        allow create: if isMe(uid)
          && placeId.size() <= 80
          && newData().keys().hasOnly(['createdAt'])
          && newData().createdAt == request.time;
        allow update: if false;
      }

      // Private notes on places (only you can see them).
      match /notes/{placeId} {
        allow read, delete: if isMe(uid);
        allow create, update: if isMe(uid)
          && placeId.size() <= 80
          && newData().keys().hasOnly(['text', 'updatedAt'])
          && newData().text is string
          && newData().text.size() > 0 && newData().text.size() <= 500
          && newData().updatedAt == request.time;
      }

      // When you last said how busy a place is (private). Written together
      // with crowd/{placeId}; at most once per place every 30 minutes.
      match /crowdMarks/{placeId} {
        allow read, delete: if isMe(uid);
        allow create, update: if isMe(uid) && !isGuest()
          && placeId.size() <= 80
          && newData().keys().hasOnly(['at'])
          && newData().at == request.time
          && (resource == null || resource.data.at < request.time - duration.value(30, 'm'))
          && getAfter(/databases/$(database)/documents/crowd/$(placeId)).data.last == request.time;
      }

      // Reviews you marked helpful (private copy, so deleting your account
      // can find and remove your votes).
      match /helpfulGiven/{reviewId} {
        allow read, delete: if isMe(uid);
        allow create: if isMe(uid) && newData().keys().hasOnly(['at']) && newData().at == request.time;
      }

      // Favorite places: just a place id and when it was added.
      match /favorites/{placeId} {
        allow read, delete: if isMe(uid);
        allow create: if isMe(uid)
          && placeId.size() <= 60
          && newData().keys().hasOnly(['createdAt'])
          && newData().createdAt == request.time;
        allow update: if false;
      }
    }

    // ---- What other users can see about you ----
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create: if isMe(uid)
        && newData().keys().hasOnly(['displayName', 'photoUrl', 'createdAt'])
        && validName(newData().displayName);
      allow update: if isMe(uid)
        && changed().hasOnly(['displayName', 'photoUrl', 'username'])
        && validName(newData().displayName)
        // A new username must be one this person owns in /usernames.
        && (!('username' in changed())
            || getAfter(/databases/$(database)/documents/usernames/$(newData().username)).data.uid == me());
      allow delete: if isMe(uid);
    }

    // One document per username, so no two people can own the same one.
    match /usernames/{name} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && !isGuest()
        && name.matches('^[a-z0-9_.]{3,20}$')
        && newData().keys().hasOnly(['uid'])
        && newData().uid == me();
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // ---- Friends: one document per pair, id = "smallerUid_largerUid" ----
    match /friendships/{id} {
      allow read: if signedIn() && (resource == null || me() in resource.data.uids);
      allow create: if signedIn()
        && newData().keys().hasOnly(['uids', 'requestedBy', 'status', 'createdAt'])
        && newData().requestedBy == me()
        && newData().status == 'pending'
        && newData().uids is list && newData().uids.size() == 2
        && me() in newData().uids
        && newData().uids[0] < newData().uids[1]
        && id == newData().uids[0] + '_' + newData().uids[1];
      // Only the person who RECEIVED the request can accept it.
      allow update: if signedIn()
        && me() in resource.data.uids
        && me() != resource.data.requestedBy
        && changed().hasOnly(['status'])
        && newData().status == 'accepted';
      // Either person can cancel, decline or unfriend.
      allow delete: if signedIn() && me() in resource.data.uids;
    }

    // ---- Check-ins: "I'm here" at a place, one per person (the latest).
    // Seen by you and the friends listed in visibleTo (the app only shows
    // ones from accepted friends). Only you can write or remove yours.
    match /checkins/{uid} {
      allow read: if signedIn() && (me() == uid || me() in resource.data.visibleTo);
      allow create, update: if isMe(uid)
        && newData().keys().hasOnly(['name', 'placeId', 'placeName', 'area', 'lat', 'lng',
                                     'visibleTo', 'createdAt'])
        && newData().name is string && newData().name.size() <= 60
        && newData().placeId is string && newData().placeId.size() <= 80
        && newData().placeName is string && newData().placeName.size() <= 120
        && newData().visibleTo is list && newData().visibleTo.size() <= 500
        && newData().createdAt == request.time;
      allow delete: if isMe(uid);
    }

    // ---- Reviews, place stars and reviewer levels ----
    // One review per person per place (id = placeId + "__" + uid). Writing,
    // changing or deleting a review must update placeStats (count, sum of
    // stars) and your reviewerStats (total, detailed, per kind) in the same
    // batch, by exactly the right amounts, so nobody can fake stars or points.
    function reviewPath(placeId, uid) {
      return /databases/$(database)/documents/reviews/$(placeId + '__' + uid);
    }
    function placeStatsPath(placeId) {
      return /databases/$(database)/documents/placeStats/$(placeId);
    }
    function reviewerStatsPath(uid) {
      return /databases/$(database)/documents/reviewerStats/$(uid);
    }
    function detailed(r) { return r.answers.size() >= 3 && r.text.size() >= 50; }
    function oneIf(b) { return b ? 1 : 0; }
    function revBefore(placeId, uid) { return exists(reviewPath(placeId, uid)); }
    function revAfter(placeId, uid) { return existsAfter(reviewPath(placeId, uid)); }
    function starsBefore(placeId, uid) {
      return revBefore(placeId, uid) ? get(reviewPath(placeId, uid)).data.stars : 0;
    }
    function starsAfter(placeId, uid) {
      return revAfter(placeId, uid) ? getAfter(reviewPath(placeId, uid)).data.stars : 0;
    }
    function validReview(r, placeId) {
      return r.keys().hasOnly(['placeId', 'uid', 'name', 'stars', 'text', 'answers', 'category',
                               'createdAt', 'updatedAt'])
        && r.uid == me() && r.placeId == placeId
        && placeId is string && placeId.size() > 0 && placeId.size() <= 120
        && validName(r.name)
        && r.stars is int && r.stars >= 1 && r.stars <= 5
        && r.text is string && r.text.size() <= 1000
        // No links or phone numbers in public reviews (no spam or ads).
        && !r.text.matches('(?s).*(https?://|www[.]).*')
        && !r.text.matches('(?s).*[0-9٠-٩][0-9٠-٩ -]{7,}[0-9٠-٩].*')
        && r.answers is map && r.answers.size() <= 20
        && r.category is string && r.category.size() > 0 && r.category.size() <= 30
        && r.updatedAt == request.time;
    }

    // "Helpful" votes on a review: one per person, never on your own review.
    match /reviews/{reviewId}/helpful/{voter} {
      allow read: if signedIn();
      allow create: if isMe(voter) && !isGuest()
        && newData().keys().hasOnly(['at'])
        && newData().at == request.time
        && get(/databases/$(database)/documents/reviews/$(reviewId)).data.uid != me();
      allow delete: if isMe(voter);
    }

    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if signedIn() && !isGuest()
        && reviewId == newData().placeId + '__' + me()
        && validReview(newData(), newData().placeId)
        && newData().createdAt == request.time
        && existsAfter(placeStatsPath(newData().placeId))
        && existsAfter(reviewerStatsPath(me()))
        && psAfter(newData().placeId).count == psBefore(newData().placeId).count + 1
        && psAfter(newData().placeId).sum == psBefore(newData().placeId).sum + newData().stars
        && rsAfter().total == rsBefore().total + 1;
      allow update: if signedIn() && !isGuest()
        && resource.data.uid == me()
        && validReview(newData(), resource.data.placeId)
        && newData().createdAt == resource.data.createdAt
        && newData().category == resource.data.category
        && psAfter(resource.data.placeId).sum
             == psBefore(resource.data.placeId).sum - resource.data.stars + newData().stars
        && rsAfter().detailed == rsBefore().detailed
             - oneIf(detailed(resource.data)) + oneIf(detailed(newData()));
      allow delete: if signedIn() && resource.data.uid == me()
        && psAfter(resource.data.placeId).count == psBefore(resource.data.placeId).count - 1
        && rsAfter().total == rsBefore().total - 1;
    }

    // Stars of a place: only changed alongside your own review, by its delta.
    match /placeStats/{placeId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && newData().keys().hasOnly(['count', 'sum'])
        && newData().count == (resource == null ? 0 : resource.data.count)
             + oneIf(revAfter(placeId, me())) - oneIf(revBefore(placeId, me()))
        && newData().sum == (resource == null ? 0 : resource.data.sum)
             + starsAfter(placeId, me()) - starsBefore(placeId, me())
        && (revAfter(placeId, me()) || revBefore(placeId, me()));
      allow delete: if false;
    }

    // How busy a place is right now: counts only, no names. Each report adds
    // exactly 1, together with your private crowdMarks entry (which limits
    // you to one report per place every 30 minutes). A new 2-hour window
    // starts from zero.
    match /crowd/{placeId} {
      function crowdKeys() { return ['quiet', 'normal', 'busy', 'since', 'last']; }
      function c(d, k) { return d.get(k, 0); }
      function oneOrZero(n) { return n == 0 || n == 1; }
      function sumOf(d) { return c(d, 'quiet') + c(d, 'normal') + c(d, 'busy'); }
      function continues() {
        return resource != null
          && resource.data.since > request.time - duration.value(2, 'h')
          && newData().since == resource.data.since
          && oneOrZero(newData().quiet - c(resource.data, 'quiet'))
          && oneOrZero(newData().normal - c(resource.data, 'normal'))
          && oneOrZero(newData().busy - c(resource.data, 'busy'))
          && sumOf(newData()) == sumOf(resource.data) + 1;
      }
      function startsOver() {
        return (resource == null || resource.data.since <= request.time - duration.value(2, 'h'))
          && newData().since == request.time
          && oneOrZero(newData().quiet) && oneOrZero(newData().normal) && oneOrZero(newData().busy)
          && sumOf(newData()) == 1;
      }
      allow read: if signedIn();
      allow create, update: if signedIn() && !isGuest()
        && placeId.size() <= 80
        && newData().keys().hasOnly(crowdKeys()) && newData().keys().hasAll(crowdKeys())
        && newData().quiet is int && newData().normal is int && newData().busy is int
        && newData().last == request.time
        && getAfter(/databases/$(database)/documents/users/$(me())/crowdMarks/$(placeId)).data.at == request.time
        && (continues() || startsOver());
      allow delete: if false;
    }

    // Your reviewer numbers (public, for levels and badges). Each change must
    // match the review you're writing in the same batch.
    match /reviewerStats/{uid} {
      function oldS() { return resource == null ? {'total': 0, 'detailed': 0, 'cats': {}} : resource.data; }
      allow read: if signedIn();
      allow create, update: if isMe(uid)
        && newData().keys().hasOnly(['total', 'detailed', 'cats', 'place'])
        && newData().place is string
        && statsMatch(oldS(), newData(), newData().place, uid);
      allow delete: if isMe(uid) && resource.data.total == 0;
    }
    function statsMatch(o, n, placeId, uid) {
      return statsDelta(o, n, placeId, uid,
        revBefore(placeId, uid) ? get(reviewPath(placeId, uid)).data : null,
        revAfter(placeId, uid) ? getAfter(reviewPath(placeId, uid)).data : null);
    }
    function statsDelta(o, n, placeId, uid, b, a) {
      return (a != null || b != null)
        && n.total == o.total + oneIf(a != null) - oneIf(b != null)
        && n.detailed == o.detailed + oneIf(a != null && detailed(a)) - oneIf(b != null && detailed(b))
        && catsDelta(o.cats, n.cats, a != null ? a.category : b.category,
                     oneIf(a != null) - oneIf(b != null));
    }
    function catsDelta(oc, nc, cat, dc) {
      return nc is map
        && (dc == 0 ? nc == oc
                    : nc.diff(oc).affectedKeys().hasOnly([cat]) && nc.get(cat, 0) == oc.get(cat, 0) + dc);
    }
    // What the stats docs hold before and after this batch.
    function psBefore(placeId) {
      return exists(placeStatsPath(placeId)) ? get(placeStatsPath(placeId)).data : {'count': 0, 'sum': 0};
    }
    function psAfter(placeId) { return getAfter(placeStatsPath(placeId)).data; }
    function rsBefore() {
      return exists(reviewerStatsPath(me())) ? get(reviewerStatsPath(me())).data : {'total': 0, 'detailed': 0};
    }
    function rsAfter() { return getAfter(reviewerStatsPath(me())).data; }

    // ---- Reports, feedback and error reports: write-only ----
    // Nobody can read them in the app; the owner reviews them in the
    // Firebase console. Small and limited so they can't be abused.
    match /reports/{id} {
      allow read, update, delete: if false;
      allow create: if signedIn()
        && newData().keys().hasOnly(['by', 'kind', 'targetUid', 'groupId', 'messageId', 'placeId',
                                     'text', 'reason', 'createdAt'])
        && newData().by == me()
        && newData().kind in ['message', 'user', 'review', 'ai']
        && newData().reason is string && newData().reason.size() > 0 && newData().reason.size() <= 300
        && (!('text' in newData()) || (newData().text is string && newData().text.size() <= 1000))
        && newData().createdAt == request.time;
    }
    match /feedback/{id} {
      allow read, update, delete: if false;
      allow create: if signedIn()
        && newData().keys().hasOnly(['by', 'text', 'appVersion', 'createdAt'])
        && newData().by == me()
        && newData().text is string && newData().text.size() > 0 && newData().text.size() <= 1000
        && newData().createdAt == request.time;
    }
    match /errorReports/{id} {
      allow read, update, delete: if false;
      allow create: if signedIn()
        && newData().keys().hasOnly(['by', 'message', 'stack', 'appVersion', 'createdAt'])
        && newData().by == me()
        && newData().message is string && newData().message.size() <= 500
        && newData().stack is string && newData().stack.size() <= 4000
        && newData().createdAt == request.time;
    }

    // ---- Invite codes: look up one code at a time; listing is blocked ----
    match /joinCodes/{code} {
      allow get: if signedIn();
      allow list, update: if false;
      allow create: if signedIn()
        && code.matches('^[A-Z0-9]{6}$')
        && newData().keys().hasOnly(['groupId'])
        && getAfter(/databases/$(database)/documents/groups/$(newData().groupId)).data.ownerUid == me()
        && getAfter(/databases/$(database)/documents/groups/$(newData().groupId)).data.joinCode == code;
      allow delete: if signedIn()
        && get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.ownerUid == me();
    }

    // ---- Groups ----
    match /groups/{groupId} {
      function isMember() { return signedIn() && me() in resource.data.memberUids; }
      function oldMembers() { return resource.data.memberUids.toSet(); }
      function newMembers() { return newData().memberUids.toSet(); }
      function onlyAdds(uid) {
        return newMembers() == oldMembers().union([uid].toSet())
          && !(uid in resource.data.memberUids)
          && newData().memberUids.size() == resource.data.memberUids.size() + 1
          && newData().memberUids.size() <= 50;
      }

      allow read: if signedIn() && (resource == null || isMember());

      allow create: if signedIn()
        && newData().keys().hasOnly(['name', 'ownerUid', 'memberUids', 'joinCode', 'scheduledAt',
                                     'rsvp', 'freeUids', 'planId', 'planTitle', 'planStops',
                                     'createdAt', 'lastMessageAt'])
        && newData().ownerUid == me()
        && newData().memberUids == [me()]
        && newData().freeUids == []
        && newData().rsvp.keys().hasOnly([me()]) && newData().rsvp[me()] == 'going'
        && validName(newData().name)
        && newData().planStops is list && newData().planStops.size() <= 5
        && getAfter(/databases/$(database)/documents/joinCodes/$(newData().joinCode)).data.groupId == groupId;

      allow update: if signedIn() && (
        // Joining with an invite code: add yourself, nothing else.
        (changed().hasOnly(['memberUids']) && onlyAdds(me()))
        ||
        // A member adds one of their accepted friends.
        (isMember()
          && changed().hasOnly(['memberUids', 'lastAddedUid'])
          && onlyAdds(newData().lastAddedUid)
          && get(/databases/$(database)/documents/friendships/$(pairId(me(), newData().lastAddedUid))).data.status == 'accepted')
        ||
        // A member changes only their own RSVP.
        (isMember()
          && changed().hasOnly(['rsvp'])
          && newData().rsvp.diff(resource.data.rsvp).affectedKeys().hasOnly([me()])
          && newData().rsvp[me()] in ['going', 'maybe', 'no'])
        ||
        // A member (not the organizer) leaves.
        (isMember()
          && me() != resource.data.ownerUid
          && changed().hasOnly(['memberUids', 'rsvp', 'freeUids'])
          && newMembers() == oldMembers().difference([me()].toSet())
          && !(me() in newData().rsvp)
          && newData().rsvp.diff(resource.data.rsvp).affectedKeys().hasOnly([me()])
          && newData().freeUids.toSet() == resource.data.freeUids.toSet().difference([me()].toSet()))
        ||
        // A member sends a message: update the preview shown in the list.
        (isMember()
          && changed().hasOnly(['lastMessage', 'lastMessageAt'])
          && newData().lastMessage is string && newData().lastMessage.size() <= 120
          && newData().lastMessageAt == request.time)
        ||
        // The organizer: name, date, who doesn't pay, a pinned note, the meeting point.
        (me() == resource.data.ownerUid
          && changed().hasOnly(['scheduledAt', 'freeUids', 'name', 'pinned',
                                'meetPlaceId', 'meetPlaceName'])
          && newData().freeUids is list
          && validName(newData().name)
          && (newData().scheduledAt == null || newData().scheduledAt is timestamp)
          && (!('pinned' in newData()) || newData().pinned == null
              || (newData().pinned is string && newData().pinned.size() <= 300))
          && (!('meetPlaceId' in newData()) || newData().meetPlaceId == null
              || (newData().meetPlaceId is string && newData().meetPlaceId.size() <= 80))
          && (!('meetPlaceName' in newData()) || newData().meetPlaceName == null
              || (newData().meetPlaceName is string && newData().meetPlaceName.size() <= 100)))
        ||
        // The organizer removes one member (never themselves).
        (me() == resource.data.ownerUid
          && changed().hasOnly(['memberUids', 'rsvp', 'freeUids'])
          && oldMembers().difference(newMembers()).size() == 1
          && newMembers().difference(oldMembers()).size() == 0
          && me() in newData().memberUids
          && newData().rsvp.keys().toSet().difference(newMembers()).size() == 0
          && newData().freeUids.toSet().difference(newMembers()).size() == 0)
      );

      allow delete: if signedIn() && me() == resource.data.ownerUid;

      match /messages/{messageId} {
        function group() { return get(/databases/$(database)/documents/groups/$(groupId)).data; }
        function member() { return signedIn() && me() in group().memberUids; }

        allow read: if member();
        allow create: if member()
          && newData().keys().hasOnly(['uid', 'name', 'text', 'createdAt', 'replyTo', 'replyName'])
          && (!('replyTo' in newData()) || (newData().replyTo is string && newData().replyTo.size() <= 200))
          && (!('replyName' in newData()) || (newData().replyName is string && newData().replyName.size() <= 60))
          && newData().uid == me()
          && newData().text is string
          && newData().text.size() > 0 && newData().text.size() <= 1000
          && newData().name is string && newData().name.size() <= 60
          && newData().createdAt == request.time;
        // Members can add, change or remove only their own emoji reaction.
        allow update: if member()
          && changed().hasOnly(['reactions'])
          && newData().reactions is map
          && newData().reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([me()])
          && (!(me() in newData().reactions)
              || (newData().reactions[me()] is string && newData().reactions[me()].size() <= 8));
        // Your own messages, or all of them when the organizer deletes the group.
        allow delete: if signedIn() && (resource.data.uid == me() || group().ownerUid == me());
      }

      // Polls: any member asks; each member votes once (and can change it).
      match /polls/{pollId} {
        function group() { return get(/databases/$(database)/documents/groups/$(groupId)).data; }
        function member() { return signedIn() && me() in group().memberUids; }

        allow read: if member();
        allow create: if member()
          && newData().keys().hasOnly(['uid', 'question', 'options', 'votes', 'createdAt'])
          && newData().uid == me()
          && newData().question is string
          && newData().question.size() > 0 && newData().question.size() <= 150
          && newData().options is list
          && newData().options.size() >= 2 && newData().options.size() <= 6
          && newData().votes == {}
          && newData().createdAt == request.time;
        allow update: if member()
          && changed().hasOnly(['votes'])
          && newData().votes.diff(resource.data.votes).affectedKeys().hasOnly([me()])
          && (!(me() in newData().votes)
              || (newData().votes[me()] is int && newData().votes[me()] >= 0
                  && newData().votes[me()] < resource.data.options.size()));
        allow delete: if signedIn() && (resource.data.uid == me() || group().ownerUid == me());
      }

      // "Who's bringing what": anyone in the group adds a thing; anyone can
      // say "I'll bring it" (only for themselves) or let it go again.
      match /items/{itemId} {
        function group() { return get(/databases/$(database)/documents/groups/$(groupId)).data; }
        function member() { return signedIn() && me() in group().memberUids; }

        allow read: if member();
        allow create: if member()
          && newData().keys().hasOnly(['uid', 'name', 'text', 'takenBy', 'takenName', 'createdAt'])
          && newData().uid == me()
          && validName(newData().name)
          && newData().text is string && newData().text.size() > 0 && newData().text.size() <= 60
          && newData().takenBy == null && newData().takenName == null
          && newData().createdAt == request.time;
        allow update: if member()
          && changed().hasOnly(['takenBy', 'takenName'])
          && ((resource.data.takenBy == null && newData().takenBy == me() && validName(newData().takenName))
              || (resource.data.takenBy == me() && newData().takenBy == null && newData().takenName == null));
        allow delete: if signedIn() && (resource.data.uid == me() || group().ownerUid == me());
      }

      // Live location during an outing: each member writes only their own
      // spot, for a limited time (at most 4 hours ahead), and only members
      // can see it. You can always delete your own, even after leaving; the
      // organizer can clear them when deleting the group.
      match /live/{uid} {
        function liveGroup() { return get(/databases/$(database)/documents/groups/$(groupId)).data; }
        function liveMember() { return signedIn() && me() in liveGroup().memberUids; }
        function validLive() {
          return newData().keys().hasOnly(['lat', 'lng', 'name', 'updatedAt', 'until', 'status'])
            && newData().lat is number && newData().lat >= -90 && newData().lat <= 90
            && newData().lng is number && newData().lng >= -180 && newData().lng <= 180
            && validName(newData().name)
            && newData().updatedAt == request.time
            && newData().until is timestamp
            && newData().until > request.time
            && newData().until <= request.time + duration.value(4, 'h')
            && (newData().get('status', null) == null || newData().status in ['way', 'here']);
        }

        allow read: if liveMember();
        allow create, update: if isMe(uid) && liveMember() && validLive();
        allow delete: if isMe(uid) || (signedIn() && liveGroup().ownerUid == me());
      }
    }
  }
}
