rules_version = '2';

// Khroga security rules.
// Principle: the app may only make small, safe changes directly. Anything that
// must be trustworthy (plans, usernames, join codes, joining/leaving/deleting
// groups) is done by Cloud Functions, which bypass these rules.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function validName(n) { return n is string && n.size() > 0 && n.size() <= 40; }

    // Real places: read-only for everyone signed in. Only admin scripts write.
    match /places/{placeId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Private user data (push tokens).
    match /users/{uid} {
      allow read: if isMe(uid);
      allow create: if isMe(uid)
        && request.resource.data.keys().hasOnly(['createdAt', 'fcmTokens']);
      allow update: if isMe(uid)
        && changed().hasOnly(['createdAt', 'fcmTokens'])
        && request.resource.data.fcmTokens is list
        && request.resource.data.fcmTokens.size() <= 20;
      allow delete: if false;

      // Plans are written by the server. The owner can only (un)save or delete.
      match /plans/{planId} {
        allow read, delete: if isMe(uid);
        allow update: if isMe(uid)
          && changed().hasOnly(['saved'])
          && request.resource.data.saved is bool;
        allow create: if false;
      }
    }

    // What other users can see about you. Username is set by the server only.
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create: if isMe(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'photoUrl', 'createdAt'])
        && validName(request.resource.data.displayName);
      allow update: if isMe(uid)
        && changed().hasOnly(['displayName', 'photoUrl'])
        && validName(request.resource.data.displayName);
      allow delete: if false;
    }

    match /usernames/{name} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /joinCodes/{code} {
      allow read, write: if false;
    }

    // One document per pair of users, id = "smallerUid_largerUid".
    match /friendships/{id} {
      allow read: if signedIn()
        && (resource == null || request.auth.uid in resource.data.uids);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uids', 'requestedBy', 'status', 'createdAt'])
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.uids is list
        && request.resource.data.uids.size() == 2
        && request.auth.uid in request.resource.data.uids
        && request.resource.data.uids[0] < request.resource.data.uids[1]
        && id == request.resource.data.uids[0] + '_' + request.resource.data.uids[1];
      // Only the person who RECEIVED the request can accept it.
      allow update: if signedIn()
        && request.auth.uid in resource.data.uids
        && request.auth.uid != resource.data.requestedBy
        && changed().hasOnly(['status'])
        && request.resource.data.status == 'accepted';
      // Either person can cancel, decline or unfriend.
      allow delete: if signedIn() && request.auth.uid in resource.data.uids;
    }

    match /groups/{groupId} {
      function isMember() {
        return signedIn() && request.auth.uid in resource.data.memberUids;
      }

      allow read: if signedIn() && (resource == null || isMember());
      allow create, delete: if false;
      allow update: if isMember() && (
        // Anyone in the group: change only their own RSVP.
        (changed().hasOnly(['rsvp'])
          && request.resource.data.rsvp.diff(resource.data.rsvp).affectedKeys()
               .hasOnly([request.auth.uid])
          && request.resource.data.rsvp[request.auth.uid] in ['going', 'maybe', 'no'])
        ||
        // Organizer: date, name and who doesn't pay.
        (request.auth.uid == resource.data.ownerUid
          && changed().hasOnly(['scheduledAt', 'freeUids', 'name'])
          && request.resource.data.freeUids is list
          && validName(request.resource.data.name)
          && (request.resource.data.scheduledAt == null
              || request.resource.data.scheduledAt is timestamp))
      );

      match /messages/{messageId} {
        function member() {
          return signedIn() && request.auth.uid in
            get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
        }
        allow read: if member();
        allow create: if member()
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 60
          && request.resource.data.createdAt == request.time;
        // Messages can't be edited by anyone; the server deletes them with the group.
        allow update, delete: if false;
      }
    }
  }
}
