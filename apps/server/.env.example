DATABASE_URL="postgresql://cookapp:cookapp_dev_pw@localhost:5432/cookapp"
JWT_SECRET="change-me-in-production"
PORT=4000

# Optional: enables POST /api/auth/google. Must match the mobile app's
# EXPO_PUBLIC_GOOGLE_CLIENT_ID (same Google OAuth "Web application" Client ID).
# Google sign-in returns a clear "not configured" error until this is set.
GOOGLE_CLIENT_ID=
