# Base URL of the Cookmate API. Expo exposes EXPO_PUBLIC_* vars to app code at build time.
# Android emulator: use 10.0.2.2 to reach your host machine's localhost.
# iOS simulator / web: localhost works directly.
# Physical device: use your computer's LAN IP, e.g. http://192.168.1.20:4000/api
EXPO_PUBLIC_API_URL=http://localhost:4000/api
