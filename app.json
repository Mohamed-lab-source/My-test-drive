{
  "expo": {
    "name": "Anchor",
    "slug": "anchor",
    "scheme": "anchor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anchor.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anchor.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "@react-native-firebase/app",
      "expo-notifications",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Inter",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Inter_300Light.ttf",
                    "weight": 300
                  },
                  {
                    "path": "./assets/fonts/Inter_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Inter_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Inter_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Inter_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/Inter_800ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F2F7",
          "image": "./assets/icon.png",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "SmartWidget",
              "label": "Anchor · Smart Stack",
              "description": "Shows what matters right now — a meeting about to start, a prayer to mark, a bill due, what you can spend today — with a one-tap action",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "PrayerWidget",
              "label": "Anchor · Prayers",
              "description": "Today's prayers with their times — the next one highlighted, tap to mark one done",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical",
              "targetCellWidth": 4,
              "targetCellHeight": 2
            },
            {
              "name": "TasksWidget",
              "label": "Anchor · Today",
              "description": "Today's tasks, most important first, with progress — tap a circle to finish one",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical",
              "targetCellWidth": 4,
              "targetCellHeight": 3
            },
            {
              "name": "MoneyWidget",
              "label": "Anchor · Net Worth",
              "description": "Net worth with a 30-day trend, today's spending and your next bill",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical",
              "targetCellWidth": 4,
              "targetCellHeight": 2
            },
            {
              "name": "SpendWidget",
              "label": "Anchor · Spending",
              "description": "What's left to spend today, this week and this month from your plan",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "LifeWidget",
              "label": "Anchor · Habits & Water",
              "description": "Tick off today's habits and add a glass of water without opening the app",
              "minWidth": "250dp",
              "minHeight": "140dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
